<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>TapDog</string>
	<key>CFBundleIdentifier</key>
	<string>com.local.tapdog</string>
	<key>CFBundleName</key>
	<string>TapDog</string>
	<key>CFBundleDisplayName</key>
	<string>TapDog</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.local.tapdog</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tapdog</string>
			</array>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>1.28.0</string>
	<key>CFBundleVersion</key>
	<string>56</string>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>从相册挑一张截图，框出要识别的图案存成模板</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>把框好的识图模板存进相册（可选）</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDarkContent</string>
	<!-- 远程调试通道走的是自建服务器的 http 明文接口（默认 211.154.18.252:39888）。
	     ATS 默认会把明文请求直接拦掉。这里整体放开：中转站地址是可以自己改的，
	     只钉一个域名的话换个 IP 就连不上了，而这是自签给本机用的工具，不走商店审核。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 界面整体是白底黑字，强制 Light：不然系统深色模式下系统控件（键盘、分段控件、
	     弹窗）会变深色，和白底撞在一起。 -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
